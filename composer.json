{
    "name": "mblsolutions/link-module-php-laravel",
    "description": "Link Module interface for Laravel PHP applications.",
    "license": "proprietary",
    "type": "library",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "mblsolutions/link-module-php": "^1.0",
        "illuminate/support": "^11.0|^12.0",
        "spatie/laravel-data": "^4.7",
        "nesbot/carbon": "^2.72.2|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^10.0",
        "phpstan/phpstan": "^2.0",
        "larastan/larastan": "^3.0",
        "brianium/paratest": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "MBLSolutions\\LinkModuleLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:parallel": "vendor/bin/paratest --processes=4",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "authors": [
        {
            "name": "Hayley Berry",
            "email": "hayley.berry@appreciategroup.co.uk"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "MBLSolutions\\LinkModuleLaravel\\LinkModuleServiceProvider"
            ]
        }
    }
}
